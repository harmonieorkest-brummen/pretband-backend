# ─────────────────────────────────────────────────────────
# Copy this to .env.local for local dev (vercel dev).
# All of these must also be set in the Vercel project settings.
# NEVER commit real values — .env / .env.local are gitignored.
# ─────────────────────────────────────────────────────────

# Connection URL for your Redis instance.
# Format:  redis://:<password>@<host>:<port>   (use rediss:// for TLS)
REDIS_URL=

# Bcrypt hash of the admin password.
# Generate: node -e "const b=require('bcryptjs'); console.log(b.hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=

# Random secret used to sign JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
