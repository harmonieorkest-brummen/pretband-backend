# ─────────────────────────────────────────────────────────
# Copy this to .env.local for local dev (vercel dev).
# All of these must also be set in the Vercel project settings.
# NEVER commit real values — .env / .env.local are gitignored.
# ─────────────────────────────────────────────────────────

# Connection URL for your Redis instance.
# Format:  redis://:<password>@<host>:<port>   (use rediss:// for TLS)
REDIS_URL=

# Bcrypt hash of the admin password.
# Generate: node -e "const b=require('bcryptjs'); console.log(b.hashSync('YOUR_PASSWORD', 12))"
ADMIN_PASSWORD_HASH=

# Random secret used to sign JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Optional: dashboard "Website traffic" widget (Google Analytics 4) ──
# Leave both unset to keep the widget in its "not connected" state.
#  1. In Google Cloud, create a service account and enable the Analytics Data API.
#  2. In GA4 Admin → Property Access Management, add the service account
#     (…@….iam.gserviceaccount.com) as a Viewer.
#  3. Put the numeric GA4 property id here, and the FULL service-account JSON key
#     (as a single-line string) in GA4_SA_KEY.
GA4_PROPERTY_ID=
GA4_SA_KEY=
