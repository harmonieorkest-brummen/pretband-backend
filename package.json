	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"build:test": "tsc -p tsconfig.test.json",
		"test": "npm run build:test && node --test --experimental-test-coverage --test-coverage-include='.test-dist/api/**' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 .test-dist/test/api/*.test.js .test-dist/test/lib/*.test.js",
		"dev": "vercel dev",
		"deploy": "vercel --prod"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@vercel/node": "^5.9.7",
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"@vercel/blob": "^2.8.0",
		"bcryptjs": "^3.0.3",
		"jose": "^6.2.8",
		"redis": "^6.2.1"
	},
	"overrides": {
		"ajv": "^8.20.0",
		"js-yaml": "^4.3.0",
		"path-to-regexp": "^6.3.0",
		"smol-toml": "^1.7.1",
		"undici": "^6.28.0",
		"@vercel/python-analysis": {
			"minimatch": "^10.2.6"
		}
	}
}
