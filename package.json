{
	"license": "MIT",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"build:test": "tsc -p tsconfig.test.json",
		"test": "npm run build:test && node --test --experimental-test-coverage --test-coverage-include='.test-dist/api/**' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 .test-dist/test/api/*.test.js .test-dist/test/lib/*.test.js",
		"dev": "vercel dev",
		"deploy": "vercel --prod"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@vercel/node": "^5.8.25",
		"typescript": "^6.0.2"
	},
	"dependencies": {
		"@vercel/blob": "^2.6.1",
		"bcryptjs": "^3.0.3",
		"jose": "^6.2.2",
		"redis": "^6.1.0"
	}
}
